#!/bin/sh
set -eu

lb config noauto \
  --mode debian \
  --distribution stable \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --archive-areas "main contrib non-free-firmware" \
  --debian-installer false \
  --bootappend-live "boot=live components hostname=termos username=termos" \
  --iso-application "TermOS" \
  --iso-publisher "TermOS Project" \
  --iso-volume "TERMOS_0_3_0" \
  --debootstrap-options "--variant=minbase" \
  "$@"
